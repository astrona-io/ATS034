{
  "context": "kind-astro-ats-034-lab-020-02-01",
  "resources": [
    {
      "kind": "pod",
      "name": "login-reader",
      "namespace": "starfleet",
      "expected": {
        "apiVersion": "v1",
        "kind": "Pod",
        "metadata": {
          "name": "login-reader",
          "namespace": "starfleet"
        },
        "spec": {
          "restartPolicy": "Never",
          "automountServiceAccountToken": false,
          "containers": [
            {
              "name": "reader",
              "image": "docker.io/library/busybox:1.37.0",
              "command": [
                "sh",
                "-c",
                "sleep 3600"
              ],
              "volumeMounts": [
                {
                  "name": "login",
                  "mountPath": "/login",
                  "readOnly": true
                }
              ]
            }
          ],
          "volumes": [
            {
              "name": "login",
              "secret": {
                "secretName": "probe-login",
                "defaultMode": 256
              }
            }
          ]
        }
      },
      "state": "pod"
    },
    {
      "kind": "secret",
      "name": "probe-login",
      "namespace": "starfleet",
      "expected": {
        "type": "kubernetes.io/basic-auth",
        "immutable": true,
        "data": {
          "username": "c2NvdXQ=",
          "password": "ZGlzcG9zYWJsZS1sb2dpbg=="
        }
      }
    }
  ],
  "behavior": [
    {
      "args": [
        "kubectl",
        "-n",
        "starfleet",
        "exec",
        "login-reader",
        "--",
        "sh",
        "-c",
        "test \"$(cat /login/username)\" = scout && test \"$(cat /login/password)\" = disposable-login"
      ]
    },
    {
      "args": [
        "kubectl",
        "-n",
        "starfleet",
        "patch",
        "secret",
        "probe-login",
        "--type",
        "merge",
        "-p",
        "{\"stringData\":{\"password\":\"changed\"}}"
      ],
      "denied": true,
      "failure_markers": [
        "immutable"
      ]
    }
  ]
}
